{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServerConnectionString": "Server=localhost,1433;Database=PermissionAttributeTaskDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;Encrypt=False"
  },
  "PermissionRolesSettings": {
    "PermissionRoles": {
      "GetProfileById": ["User", "Manager", "Administrator"],
      "GetProfiles": ["User", "Manager", "Administrator"],
      "AddUserProfile": ["Manager", "Administrator"],
      "UpdateUserProfile": ["Manager", "Administrator"],
      "DeleteUserProfile": ["Manager", "Administrator"]
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/app-${shortdate}.log"
      },
      "logconsole": {
        "type": "ColoredConsole"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      },
      {
        "logger": "PermissionsAttributeTask.Main.Middleware.*",
        "minLevel": "Info",
        "writeTo": "logfile"
      }
    ]
  }
}
